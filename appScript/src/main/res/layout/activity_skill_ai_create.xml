<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/colorPrimary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.carlos.ui.header.CommonHeader
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:enable_back="true"
            app:bg_color="@color/colorPrimary"
            app:center_text="@string/skill_ai_create_title"
            app:center_text_color="@color/design_text_secondary"
            app:show_btm_line="false"
            app:left_img_color="@color/design_text_secondary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/design_border_subtle" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingLeft="@dimen/design_spacing_page_horizontal"
            android:paddingRight="@dimen/design_spacing_page_horizontal"
            android:paddingTop="@dimen/design_spacing_5"
            android:paddingBottom="@dimen/design_spacing_6"
            android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/skill_ai_create_desc"
                    android:textColor="@color/design_text_tertiary"
                    android:textSize="@dimen/design_font_lg" />

                <EditText
                    android:id="@+id/edit_requirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/design_spacing_4"
                    android:background="@drawable/design_publish_input_bg"
                    android:gravity="top|start"
                    android:hint="@string/skill_ai_create_requirement_hint"
                    android:inputType="textMultiLine"
                    android:minHeight="188dp"
                    android:padding="@dimen/design_spacing_4"
                    android:textColor="@color/design_text_secondary"
                    android:textColorHint="@color/design_text_muted"
                    android:textSize="@dimen/design_font_lg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/design_spacing_5"
                    android:text="@string/skill_ai_create_examples"
                    android:textAllCaps="true"
                    android:textColor="@color/design_text_muted"
                    android:textSize="@dimen/design_font_sm"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/example_1"
                    style="@style/SkillExampleChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/design_spacing_2"
                    android:text="@string/skill_ai_example_1" />

                <TextView
                    android:id="@+id/example_2"
                    style="@style/SkillExampleChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/design_spacing_2"
                    android:text="@string/skill_ai_example_2" />

                <TextView
                    android:id="@+id/example_3"
                    style="@style/SkillExampleChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/design_spacing_2"
                    android:text="@string/skill_ai_example_3" />

                <TextView
                    android:id="@+id/example_4"
                    style="@style/SkillExampleChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/design_spacing_2"
                    android:text="@string/skill_ai_example_4" />
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/btn_generate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_margin="@dimen/design_spacing_6"
            android:background="@drawable/bg_skill_primary_btn"
            android:gravity="center"
            android:text="@string/skill_ai_create_generate"
            android:textColor="@color/white"
            android:textSize="@dimen/design_font_lg"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/layout_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A6000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_skill_form_sheet"
            android:paddingLeft="@dimen/design_spacing_6"
            android:paddingTop="@dimen/design_spacing_5"
            android:paddingRight="@dimen/design_spacing_6"
            android:paddingBottom="@dimen/design_spacing_5">

            <ProgressBar
                android:id="@+id/progress_generating"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="28dp"
                android:layout_height="28dp" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/design_spacing_3"
                android:textColor="@color/design_text_secondary"
                android:textSize="@dimen/design_font_md" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
