<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="14dp"
    android:paddingHorizontal="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.hive.views.list_view.ListRecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="0dp"
            android:paddingBottom="112dp"
            tools:listitem="@layout/item_skill" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/design_spacing_6"
        android:visibility="gone">

        <com.hive.views.widgets.UIResourceIconView
            android:id="@+id/icon_skill_empty"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="@dimen/design_spacing_6"
            app:ri_resourceType="skill"
            app:ri_containerShape="circle"
            app:ri_iconTint="@color/design_text_muted" />

        <TextView
            android:id="@+id/tv_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/design_spacing_2"
            android:fontFamily="sans-serif-medium"
            android:text="@string/skill_empty_title"
            android:textColor="@color/design_text_tertiary"
            android:textSize="@dimen/design_font_xl" />

        <TextView
            android:id="@+id/tv_empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/design_spacing_6"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:paddingHorizontal="@dimen/design_spacing_4"
            android:text="@string/skill_empty_desc"
            android:textColor="@color/design_text_muted"
            android:textSize="@dimen/design_font_base" />

        <Button
            android:id="@+id/btn_empty_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_empty_state_btn"
            android:fontFamily="sans-serif-black"
            android:paddingHorizontal="@dimen/design_spacing_6"
            android:paddingVertical="10dp"
            android:text="@string/skill_empty_action"
            android:textColor="@color/design_accent_indigo"
            android:textSize="@dimen/design_font_base" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
