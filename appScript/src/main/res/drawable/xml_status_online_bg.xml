<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外发光 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#6000FF88" />
        </shape>
    </item>
    
    <!-- 主体 -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <gradient 
                android:angle="135"
                android:startColor="#ff00FF88"
                android:endColor="#ff00CC66" />
        </shape>
    </item>
    
    <!-- 高光 -->
    <item android:top="3dp" android:left="3dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="oval">
            <solid android:color="#60ffffff" />
        </shape>
    </item>
</layer-list> 