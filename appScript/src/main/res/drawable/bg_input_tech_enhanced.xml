<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外层光晕效果 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:centerColor="#1A246BFD"
                android:endColor="#00246BFD"
                android:startColor="#33246BFD" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    
    <!-- 内层背景 -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="@color/colorPrimaryLight"
                android:endColor="#FF1E2128"
                android:startColor="#FF2E3238" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#33246BFD" />
        </shape>
    </item>
</layer-list>
