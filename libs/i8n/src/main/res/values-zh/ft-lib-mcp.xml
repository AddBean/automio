    <string name="mcp_server_name">Automio MCP服务器</string>
    <string name="mcp_server_version">1.0.0</string>
    <string name="mcp_server_description">Android 设备自动化与 UI 交互 MCP 服务。提供：屏幕操作（点击、滑动、输入、长按）、OCR 文字识别、布局获取、应用启动、HTTP 请求、用户对话框（确认/输入/选择）、截屏/拍照等工具。当用户需要控制 Android 设备、自动化任务或与手机界面交互时使用。</string>
