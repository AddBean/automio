    <!-- 电脑接入 MCP -->
    <string name="mcp_connect_entry">电脑接入 MCP</string>
    <string name="mcp_connect_title">电脑接入 MCP</string>
    <string name="mcp_connect_intro">把手机上的 Automio MCP 服务接到 Cursor、Claude Desktop 等电脑端客户端，即可在电脑上调用本机自动化能力。</string>
    <string name="mcp_connect_step1_title">1. 保持 App 运行</string>
    <string name="mcp_connect_step1_desc">打开 Automio 并保持应用在运行状态，MCP 服务会随应用一起启动（Streamable HTTP 端口 %1$d）。</string>
    <string name="mcp_connect_step2_title">2. 连通手机与电脑</string>
    <string name="mcp_connect_step2_adb_title">方式 A：USB + adb reverse（推荐）</string>
    <string name="mcp_connect_step2_adb_desc">用数据线连接手机，在电脑终端执行下面命令，把手机端口映射到本机：</string>
    <string name="mcp_connect_step2_lan_title">方式 B：同一 Wi-Fi 局域网</string>
    <string name="mcp_connect_step2_lan_desc">手机与电脑连同一 Wi-Fi 后，使用下方局域网地址配置。当前设备 IP：%1$s</string>
    <string name="mcp_connect_step2_lan_unknown">未知（请确认已连 Wi-Fi）</string>
    <string name="mcp_connect_step3_title">3. 粘贴 MCP 配置</string>
    <string name="mcp_connect_step3_desc">将配置写入 Cursor 的 mcp.json（或 Claude Desktop 等客户端的 MCP 设置）。点击下方代码块即可复制。</string>
    <string name="mcp_connect_config_adb_title">adb reverse 后使用（127.0.0.1）</string>
    <string name="mcp_connect_config_lan_title">局域网直连</string>
    <string name="mcp_connect_tap_copy">点击复制</string>
