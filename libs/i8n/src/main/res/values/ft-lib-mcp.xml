    <!-- Connect MCP from PC -->
    <string name="mcp_connect_entry">Connect MCP from PC</string>
    <string name="mcp_connect_title">Connect MCP from PC</string>
    <string name="mcp_connect_intro">Expose Automio\'s on-device MCP server to Cursor, Claude Desktop, or other desktop clients so you can drive phone automation from your computer.</string>
    <string name="mcp_connect_step1_title">1. Keep the app running</string>
    <string name="mcp_connect_step1_desc">Open Automio and leave it running. The MCP service starts with the app (Streamable HTTP port %1$d).</string>
    <string name="mcp_connect_step2_title">2. Link phone and PC</string>
    <string name="mcp_connect_step2_adb_title">Option A: USB + adb reverse (recommended)</string>
    <string name="mcp_connect_step2_adb_desc">Connect the phone with USB, then run this on your PC to forward the phone port locally:</string>
    <string name="mcp_connect_step2_lan_title">Option B: Same Wi-Fi LAN</string>
    <string name="mcp_connect_step2_lan_desc">Put phone and PC on the same Wi-Fi, then use the LAN URL below. Device IP: %1$s</string>
    <string name="mcp_connect_step2_lan_unknown">Unknown (check Wi-Fi)</string>
    <string name="mcp_connect_step3_title">3. Paste MCP config</string>
    <string name="mcp_connect_step3_desc">Add the config to Cursor\'s mcp.json (or Claude Desktop MCP settings). Tap a code block to copy.</string>
