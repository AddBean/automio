<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/voiceRecordingOverlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/voice_recording_overlay_bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/ffBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="30dp"
            android:background="@drawable/voice_bubble_body"
            android:gravity="center"
            android:maxWidth="280dp"
            android:minWidth="140dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp">

            <com.hive.views.widgets.VoiceWaveformView
                android:id="@+id/waveformView"
                android:layout_width="72dp"
                android:layout_height="32dp"
                tools:visibility="gone" />

            <TextView
                android:id="@+id/recognizedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.95"
                android:lineSpacingExtra="2dp"
                android:maxLines="6"
                android:minWidth="0dp"
                android:singleLine="false"
                android:textColor="@color/textColorPrimary"
                android:textSize="18sp"
                android:visibility="gone"
                tools:text="测试"
                tools:visibility="visible" />
        </LinearLayout>

        <ImageView
            android:layout_width="72dp"
            android:layout_height="12dp"
            android:layout_marginTop="-1dp"
            android:contentDescription="@null"
            android:src="@drawable/voice_bubble_tail" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_gravity="bottom"
        android:clickable="false"
        android:focusable="false">

        <com.hive.views.widgets.VoiceArcPanelView
            android:id="@+id/arcPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom" />
    </FrameLayout>
</FrameLayout>
