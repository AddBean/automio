<?xml version="1.0" encoding="utf-8"?>
<com.carlos.ui.header.StatusBarAutoPaddingView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/header_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:use_type="use_height"
    tools:background="@color/colorPrimary">

    <RelativeLayout
        android:id="@+id/header_content"
        android:layout_width="match_parent"
        android:layout_height="54dp">

        <LinearLayout
            android:id="@+id/ll_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 对齐 design：w-10 h-10 rounded-full bg-white/5 + ArrowLeft 20px -->
            <FrameLayout
                android:id="@+id/fl_left_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_common_header_back_circle">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/img_left"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_common_header_back" />
            </FrameLayout>

            <TextView
                android:id="@+id/text_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_centerInParent="true"
            android:layout_marginLeft="50dp"
            android:layout_marginRight="50dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#E6000000"
            android:textStyle="bold"
            tools:text="title texttitle text" />

        <LinearLayout
            android:id="@+id/ll_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="RtlSymmetry">

            <ImageView
                android:id="@+id/img_right"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:visibility="visible" />

            <TextView
                android:id="@+id/text_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="0.77"
                android:textColor="#000000"
                android:textSize="17sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/img_right_text_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="10dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </LinearLayout>
    </RelativeLayout>

    <!--        <View-->
    <!--            android:id="@+id/header_btm_line"-->
    <!--            android:layout_width="match_parent"-->
    <!--            android:layout_height="0.5dp"-->
    <!--            android:layout_alignParentBottom="true"-->
    <!--            android:background="#11000000" />-->

    <View
        android:id="@+id/header_btm_line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/colorSplitLine"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/clTitle" />

</com.carlos.ui.header.StatusBarAutoPaddingView>

