<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/xml_dialog_ffffff_round_rect_bg"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="-"
            android:textColor="#ff3A3A3A"
            android:textSize="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#ffeeeeee" />

        <com.hive.views.widgets.MaxHeightLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:heightDimen="300dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/layout_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:lines="1"
                    android:orientation="vertical"
                    android:textSize="14dp" />
            </ScrollView>
        </com.hive.views.widgets.MaxHeightLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#ffeeeeee" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/pref_cancel"
                android:textColor="#ff3A3A3A"
                android:textSize="14dp" />

            <View
                android:id="@+id/view_lines"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#ffeeeeee" />

            <TextView
                android:id="@+id/tv_btn_submit"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/pref_confirm"
                android:textColor="@color/color_blue"
                android:textSize="14dp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>