<?xml version = "1.0" encoding = "UTF-8"?>
<resources>
    <declare-styleable name="RatingBar">
        <!--星星总数-->
        <attr name="starCount" format="integer" />
        <!--空白的星星资源文件值-->
        <attr name="starEmpty" format="reference" />
        <!--满星资源文件值-->
        <attr name="starFill" format="reference" />
        <!--半星资源文件值-->
        <attr name="starHalf" format="reference" />
        <!--是否可点击boolean值-->
        <attr name="clickable" format="boolean" />
        <!--当前进度float值-->
        <attr name="starCurr" format="float" />
        <!--每次进度方式的值，整星还是半星-->
        <attr name="stepSize">
            <enum name="Half" value="0" />
            <enum name="Full" value="1" />
        </attr>
    </declare-styleable>
    <declare-styleable name="AVLoadingIndicatorView">
        <attr name="indicator">
            <flag name="BallPulse" value="0" />
            <flag name="BallGridPulse" value="1" />
            <flag name="BallClipRotate" value="2" />
            <flag name="BallClipRotatePulse" value="3" />
            <flag name="SquareSpin" value="4" />
            <flag name="BallClipRotateMultiple" value="5" />
            <flag name="BallPulseRise" value="6" />
            <flag name="BallRotate" value="7" />
            <flag name="CubeTransition" value="8" />
            <flag name="BallZigZag" value="9" />
            <flag name="BallZigZagDeflect" value="10" />
            <flag name="BallTrianglePath" value="11" />
            <flag name="BallScale" value="12" />
            <flag name="LineScale" value="13" />
            <flag name="LineScaleParty" value="14" />
            <flag name="BallScaleMultiple" value="15" />
            <flag name="BallPulseSync" value="16" />
            <flag name="BallBeat" value="17" />
            <flag name="LineScalePulseOut" value="18" />
            <flag name="LineScalePulseOutRapid" value="19" />
            <flag name="BallScaleRipple" value="20" />
            <flag name="BallScaleRippleMultiple" value="21" />
            <flag name="BallSpinFadeLoader" value="22" />
            <flag name="LineSpinFadeLoader" value="23" />
            <flag name="TriangleSkewSpin" value="24" />
            <flag name="Pacman" value="25" />
            <flag name="BallGridBeat" value="26" />
            <flag name="SemiCircleSpin" value="27" />
        </attr>
        <attr name="indicator_color" format="color" />
    </declare-styleable>

    <declare-styleable name="AbsStatefulLayout">
        <attr name="defState" format="enum">
            <enum name="content" value="0" />
            <enum name="progress" value="1" />
            <enum name="offline" value="2" />
            <enum name="empty" value="3" />
        </attr>
        <attr name="progressLayout" format="reference" />
        <attr name="offlineLayout" format="reference" />
        <attr name="emptyLayout" format="reference" />
        <attr name="transparent" format="boolean" />

        <attr name="progressText" format="string" />
        <attr name="offlineText" format="string" />
        <attr name="emptyText" format="string" />

    </declare-styleable>

    <declare-styleable name="DrawerLayoutContent">
        <attr name="shaderEndColor" format="color" />
        <attr name="shaderStartColor" format="color" />
        <attr name="shaderWidth" format="dimension" />
        <attr name="layoutPosition">
            <enum name="top" value="0" />
            <enum name="bottom" value="1" />
        </attr>
    </declare-styleable>

    <declare-styleable name="DrawerView">
        <attr name="paddingSide" format="dimension" />
        <attr name="gravity">
            <enum name="up" value="0" />
            <enum name="down" value="1" />
            <enum name="left" value="2" />
            <enum name="right" value="3" />
        </attr>
        <attr name="current_gravity">
            <enum name="up" value="0" />
            <enum name="down" value="1" />
            <enum name="left" value="2" />
            <enum name="right" value="3" />
        </attr>
    </declare-styleable>

    <declare-styleable name="RectImageView">
        <attr name="baseType">
            <enum name="width" value="0" />
            <enum name="height" value="1" />
        </attr>
        <attr name="sizeRate" format="float" />
    </declare-styleable>

    <declare-styleable name="LoadingView">

        <attr name="loadingText" format="string" />
        <attr name="loadingTextAppearance" format="reference" />
    </declare-styleable>

    <declare-styleable name="NumberProgressBar">
        <attr name="progress" format="integer" />
        <attr name="max" format="integer" />

        <attr name="progress_unreached_color" format="color" />
        <attr name="progress_reached_color" format="color" />

        <attr name="progress_reached_bar_height" format="dimension" />
        <attr name="progress_unreached_bar_height" format="dimension" />

        <attr name="progress_text_size" format="dimension" />
        <attr name="progress_text_color" format="color" />

        <attr name="progress_text_offset" format="dimension" />

        <attr name="progress_text_visibility" format="enum">
            <enum name="visible" value="0" />
            <enum name="invisible" value="1" />
        </attr>
    </declare-styleable>

    <declare-styleable name="Themes">
        <attr name="numberProgressBarStyle" format="reference" />
    </declare-styleable>

    <declare-styleable name="CustomGridView">
        <attr name="gridRaw" format="integer" />
        <attr name="gridPadding" format="dimension" />
        <attr name="gridRate" format="float" />
    </declare-styleable>

    <declare-styleable name="CustomRoundImageView">
        <attr name="image_radius" format="dimension" />
        <attr name="image_type">
            <enum name="circle" value="0" />
            <enum name="round" value="1" />
        </attr>
    </declare-styleable>

    <declare-styleable name="CustomRoundLayout">
        <attr name="layoutRound" format="dimension" />
        <attr name="layoutColor" format="color" />
    </declare-styleable>
    <declare-styleable name="CustomRoundLayoutView">
        <attr name="layoutViewRound" format="dimension" />
        <attr name="layoutViewColor" format="color" />
    </declare-styleable>
    <declare-styleable name="CustomSwitchView">
        <attr name="switch_state" format="boolean" />
    </declare-styleable>
    <declare-styleable name="CustomTabBtnView">
        <attr name="item_text" format="string" />
        <attr name="item_text_color" format="color" />
        <attr name="item_text_color_pressed" format="color" />
        <attr name="item_text_visiable" format="boolean" />
        <attr name="item_image_res" format="reference" />
        <attr name="item_image_res_pressed" format="reference" />
        <attr name="item_selected" format="boolean" />
    </declare-styleable>
    <declare-styleable name="CustomSeparatorViewWithColor">
        <attr name="SeparatorBottomColor" format="reference"></attr>
        <attr name="SeparatorTopColor" format="reference"></attr>
        <attr name="SeparatorColor" format="boolean"></attr>
    </declare-styleable>

    <declare-styleable name="RoundViewLayout">
        <attr name="view_draw_paint_color" format="color" />
        <attr name="round_view_radius" format="dimension" />
        <attr name="round_view_topLeftRadius" format="dimension" />
        <attr name="round_view_topRightRadius" format="dimension" />
        <attr name="round_view_bottomLeftRadius" format="dimension" />
        <attr name="round_view_bottomRightRadius" format="dimension" />
        <attr name="round_view_type" format="enum">
            <enum name="round" value="0" />
            <enum name="circle" value="1" />
        </attr>

    </declare-styleable>
    <declare-styleable name="ProgressView">
        <attr name="progressFrontColor" format="color" />
        <attr name="progressBackColor" format="color" />
        <attr name="progressPercent" format="float" />
        <attr name="progressLineWidth" format="dimension" />
        <attr name="progressPadding" format="dimension" />
        <attr name="progressRound" format="boolean" />
        <attr name="progressAnimEnable" format="boolean" />

    </declare-styleable>
    <declare-styleable name="RectRelativeLayout">
        <attr name="rectRate" format="float" />
    </declare-styleable>
    <declare-styleable name="SwitchImageView">
        <attr name="checked" format="boolean" />
        <attr name="disable_click" format="boolean" />
        <attr name="res_checked" format="reference" />
        <attr name="res_unchecked" format="reference" />
        <attr name="res_checked_tint" format="color" />
        <attr name="res_unchecked_tint" format="color" />
    </declare-styleable>
    <declare-styleable name="MaxHeightLayout">
        <attr name="heightDimen" format="dimension" />
    </declare-styleable>
    <declare-styleable name="ScrollableLayout">
        <attr name="fixTopNav" format="boolean" />
        <attr name="commonNavHeight" format="reference" />
        <attr name="enable" format="boolean"></attr>
    </declare-styleable>

    <declare-styleable name="CustomNavigationBar">
        <attr name="titleSize" format="dimension" />
        <attr name="titleText" format="string" />
        <attr name="titleColor" format="color" />

        <attr name="rightDrawable" format="reference" />
        <attr name="rightPadding" format="dimension" />
        <attr name="rightSize" format="dimension" />
        <attr name="rightColorFilter" format="color" />


        <attr name="leftDrawable" format="reference" />
        <attr name="leftPadding" format="dimension" />
        <attr name="leftSize" format="dimension" />
        <attr name="leftColorFilter" format="color" />

        <attr name="spiltLineWidth" format="dimension" />
        <attr name="spiltLineColor" format="color" />
    </declare-styleable>

    <declare-styleable name="TextDrawableView">
        <attr name="drawableLeft" format="reference" />
        <attr name="drawableBottom" format="reference" />
        <attr name="drawableRight" format="reference" />
        <attr name="drawableTop" format="reference" />
        <attr name="drawableWidth" format="dimension" />
        <attr name="drawableHeight" format="dimension" />
        <attr name="drawableRadius" format="dimension" />
    </declare-styleable>
    <declare-styleable name="InfiniteCarouseView">
        <attr name="pageMargin" format="dimension" />
        <attr name="pagePadding" format="dimension" />
        <attr name="pageScale" format="float" />
    </declare-styleable>

    <declare-styleable name="LinearGradientView">
        <attr name="android:startColor" format="color" />
        <attr name="android:centerColor" format="color" />
        <attr name="android:endColor" format="color" />
        <attr name="orientation" format="enum">
            <enum name="topBottom" value="1" />
            <enum name="bottomTop" value="2" />
        </attr>

    </declare-styleable>

    <declare-styleable name="Setting">
        <attr name="settingKey" format="string" />
        <attr name="settingDefValue" format="string" />
        <attr name="settingValueArray" format="reference" />
        <attr name="settingScale" format="float" />

        <attr name="settingTitle" format="string" />
        <attr name="settingDes" format="string" />
        <attr name="settingDialogTitle" format="string" />
        <attr name="settingDialogDes" format="string" />
        <attr name="settingMaxValue" format="float" />
        <attr name="settingMinValue" format="float" />
        <attr name="settingMultiSelect" format="boolean" />
        <attr name="android:inputType" format="enum" />

    </declare-styleable>

    <declare-styleable name="NumberOptView">
        <attr name="optNumberMax" format="integer" />
        <attr name="optNumberMin" format="integer" />
        <attr name="optNumberDefault" format="integer" />
        <attr name="optNumberInput" format="boolean" />
        <attr name="optNumberStep" format="integer" />
        <attr name="optNumberUnit" format="string" />
        <attr name="optNumberEnable" format="boolean"/>
        <attr name="optNumberType" format="enum">
            <enum name="TYPE1" value="1" />
            <enum name="TYPE2" value="2" />
        </attr>
    </declare-styleable>

    <declare-styleable name="FloatOptView">
        <attr name="optFloatMax" format="float" />
        <attr name="optFloatMin" format="float" />
        <attr name="optFloatDefault" format="float" />
        <attr name="optFloatInput" format="boolean" />
        <attr name="optFloatStep" format="float" />
        <attr name="optFloatMaxDigits" format="integer" />
        <attr name="optFloatUnit" format="string" />
        <attr name="optFloatEnable" format="boolean"/>
        <attr name="optFloatType" format="enum">
            <enum name="TYPE1" value="1" />
            <enum name="TYPE2" value="2" />
        </attr>
    </declare-styleable>

    <declare-styleable name="SelectorTabView">
        <attr name="tabDefaultValue" format="string" />
        <attr name="tabNameList" format="string" />
        <attr name="tabValueList" format="string" />
        <attr name="tabTxtColor" format="reference" />
        <attr name="tabBackground" format="reference" />
    </declare-styleable>

    <declare-styleable name="DYLoadingView">
        <!--进度条初始颜色-->
        <attr name="dyProgressColor" format="string"></attr>
        <!--进度条最小宽度即初始宽度-->
        <attr name="dyMinProgressWidth" format="dimension"></attr>
        <!--view最小宽度-->
        <attr name="dyMinWidth" format="dimension"></attr>
        <!--view最小高度-->
        <attr name="dyMinHeight" format="dimension"></attr>
    </declare-styleable>

    <declare-styleable name="StatusBarHeightView">
        <attr name="use_type" format="integer">
            <enum name="use_height" value="0" />
            <enum name="use_padding_top" value="1" />
        </attr>
    </declare-styleable>

    <!-- CommonHeader自定义属性-->
    <declare-styleable name="CommonHeader">
        <attr name="left_text" format="string" />
        <attr name="right_text" format="string" />
        <attr name="left_text_color" format="string|reference|color" />
        <attr name="left_img_color" format="string|reference|color" />
        <attr name="right_img_color" format="string|reference|color" />
        <attr name="right_text_color" format="string|reference|color" />
        <attr name="right_text_size" format="string|reference|dimension" />
        <attr name="bg_color" format="color" />
        <attr name="center_text" format="string" />
        <attr name="center_text_size" format="string|reference|dimension" />
        <attr name="center_text_color" format="string|reference|color" />
        <attr name="left_img" format="reference" />
        <attr name="enable_back" format="boolean"></attr>
        <!--        <attr name="left_img_size" format="string|reference|dimension" />-->
        <attr name="right_img" format="reference" />
        <attr name="right_text_icon" format="integer" />
        <attr name="right_text_icon_size" format="string|reference|dimension" />
        <attr name="show_btm_line" format="boolean" />
    </declare-styleable>

    <!-- UIResourceIconView: unified resource type icon container -->
    <declare-styleable name="UIResourceIconView">
        <attr name="ri_resourceType" format="enum">
            <enum name="workflow" value="0" />
            <enum name="skill" value="1" />
            <enum name="tool" value="2" />
        </attr>
        <attr name="ri_iconUrl" format="string" />
        <attr name="ri_containerShape" format="enum">
            <enum name="square" value="0" />
            <enum name="circle" value="1" />
        </attr>
        <attr name="ri_radiusRatio" format="float" />
        <attr name="ri_backgroundColor" format="color" />
        <attr name="ri_borderWidth" format="dimension" />
        <attr name="ri_borderColor" format="color" />
        <attr name="ri_innerSize" format="dimension" />
        <attr name="ri_iconTint" format="color" />
        <attr name="ri_defaultIconVisible" format="boolean" />
    </declare-styleable>

    <!-- StatusBarPlaceholderView: status bar height placeholder with extra height support -->
    <declare-styleable name="StatusBarPlaceholderView">
        <attr name="extraHeight" format="dimension" />
    </declare-styleable>
</resources>
