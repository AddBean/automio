    <style name="base"/>
    <!-- 按钮通用样式  -->
    <style name="base.button">
        <!--        <item name="android:foreground">?selectableItemBackground</item>-->
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/xml_btn_blue_round_bg</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="base.button.stroke">
        <!--        <item name="android:foreground">?selectableItemBackground</item>-->
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_strc1c1c1_r30</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="base.button.square">
        <!--        <item name="android:foreground">?selectableItemBackground</item>-->
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/xml_btn_blue_round_bg</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="base.button.line">
        <!--        <item name="android:foreground">?selectableItemBackground</item>-->
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_lblack_bottom</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="base.buttons">
        <item name="android:foreground">?selectableItemBackground</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="base.button.small">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_nbase_pbasep_sc7c7c7_r100</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <!-- 列表通用样式  -->
    <style name="base.item"/>

    <style name="base.item.title">
        <item name="android:textColor">#222222</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="base.item.desc">
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="base.item.title.small">
        <item name="android:textColor">#222222</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="base.item.desc.small">
        <item name="android:textColor">#999999</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- 通用文本编辑框 -->
    <style name="base.edit">
        <item name="android:background">@drawable/bg_common_input</item>
        <item name="android:singleLine">true</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:textColorHint">#999999</item>
        <item name="android:paddingStart">@dimen/base_gap_margin</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/public_text</item>
        <item name="android:textCursorDrawable">@drawable/ic_cursor_input</item>
    </style>

    <style name="base.edit.full">
        <item name="android:background">@drawable/bg_nf8f8f8_fstr969696</item>
    </style>

    <!-- 文本通用样式  -->
    <style name="base.content">
        <item name="android:textColor">@color/textColorPrimary</item>
    </style>

    <style name="base.content.error">
        <item name="android:textColor">@color/red</item>
    </style>

    <style name="base.content.title">
        <item name="android:textColor">@color/textColorPrimary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="base.content.desc">
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!--计数红点-->
    <style name="base.textCountDot" parent="font.white.9">
        <item name="android:layout_height">16dp</item>
        <item name="android:minWidth">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_nef7945_sff_r8</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Line">
        <item name="android:background">@color/public_line</item>
    </style>
    <style name="Line.Horizontal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
    </style>
    <style name="Line.Vertical">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="CalendarDateTextTextAppearance" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textColor">@color/calendar_text_date_color</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="CalendarWeekTextTextAppearance" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textColor">#999999</item>
        <item name="android:textSize">21sp</item>
    </style>

    <style name="CalendarHeaderTextAppearance" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">21sp</item>
    </style>

</resources>
