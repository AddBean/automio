<?xml version="1.0" encoding="utf-8"?>
<!-- 升级对话框 - 深色主题设计 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true"
    android:background="@drawable/xml_upgrade_dialog_bg"
    android:focusable="false"
    android:gravity="center"
    android:orientation="vertical">

    <!-- 头部区域 - 渐变背景 + 图标 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/xml_upgrade_header_bg"
        android:gravity="center"
        android:orientation="vertical">

        <!-- 升级图标 -->
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_upgrade_arrow"
            android:tint="@color/white" />

        <!-- 标题 -->
        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/update_dialog_title_new"
            android:textColor="@color/white"
            android:textSize="18dp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 内容区域 -->
    <LinearLayout
        android:id="@+id/dialog_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 下载进度区域 -->
        <RelativeLayout
            android:id="@+id/layout_download"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center"
            android:visibility="gone">

            <!-- 进度条 -->
            <ProgressBar
                android:id="@+id/progress_view"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_centerInParent="true"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/xml_upgrade_progress_drawable" />

            <!-- 进度百分比 -->
            <TextView
                android:id="@+id/tv_download_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/progress_view"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="12dp"
                android:text="0%"
                android:textColor="@color/design_accent_indigo"
                android:textSize="16dp"
                android:textStyle="bold" />

            <!-- 下载状态提示 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@id/progress_view"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="8dp"
                android:text="@string/update_dialog_downloading"
                android:textColor="@color/design_text_secondary"
                android:textSize="14dp" />
        </RelativeLayout>

        <!-- 通知区域 -->
        <RelativeLayout
            android:id="@+id/layout_notify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible">

            <!-- 更新提示标签 -->
            <TextView
                android:id="@+id/tv_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/xml_upgrade_tips_tag_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="@string/update_dialog_new_version"
                android:textColor="@color/white"
                android:textSize="11dp" />

            <!-- 更新内容详情 -->
            <TextView
                android:id="@+id/dialog_content_msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_tips"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.3"
                android:text=""
                android:textColor="@color/design_text_primary"
                android:textSize="14dp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- 按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp">

        <!-- 取消按钮 -->
        <Button
            android:id="@+id/dialog_btn_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:background="@drawable/xml_upgrade_btn_cancel_bg"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/update_dialog_cancel"
            android:textColor="@color/design_text_secondary"
            android:textSize="15dp" />

        <!-- 确认按钮 -->
        <Button
            android:id="@+id/dialog_btn_submit"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/xml_upgrade_btn_submit_bg"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/update_dialog_update_now"
            android:textColor="@color/white"
            android:textSize="15dp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>