<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item android:left="3dp" android:top="3dp" android:bottom="3dp" android:right="3dp">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/white_0" />
                    <padding
                        android:bottom="3px"
                        android:left="3px"
                        android:right="3px"
                        android:top="3px" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/white_1" />
                    <padding
                        android:bottom="2px"
                        android:left="2px"
                        android:right="2px"
                        android:top="2px" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/white_2" />
                    <padding
                        android:bottom="1px"
                        android:left="1px"
                        android:right="1px"
                        android:top="1px" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/white_4" />
                    <padding
                        android:bottom="1px"
                        android:left="1px"
                        android:right="1px"
                        android:top="1px" />
                    <corners
                        android:radius="22dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list android:layout_height="match_parent">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/colorPrimaryLight" />
                    <corners android:radius="22dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#0FFFFFFF" />
                </shape>
            </item>
        </layer-list>

    </item>
</layer-list>