<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外层阴影 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/black_20" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- 主背景 - 深色卡片风格 -->
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/design_bg_card" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- 边框 - 微妙的分隔 -->
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/design_border_subtle" />
            <solid android:color="@color/transparent" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>