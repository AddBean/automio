<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 普通状态 - 半透明深色背景 -->
    <item android:state_pressed="false">
        <layer-list>
            <!-- 主体背景 -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/bg_white_trans_9" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <!-- 微妙边框 -->
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="@color/design_border_subtle" />
                    <solid android:color="@color/transparent" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- 按下状态 - 更深的背景 -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/bg_white_trans_12" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="@color/white_20" />
                    <solid android:color="@color/transparent" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>