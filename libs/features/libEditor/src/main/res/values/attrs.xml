<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="colorPrimary" format="color" />
    <declare-styleable name="CustomRoundLayout">
        <attr name="defaultColor" format="reference"></attr>
        <attr name="childTextViewColor" format="reference"></attr>
        <attr name="isFill" format="boolean"></attr>
        <attr name="lineWidth" format="dimension"></attr>
    </declare-styleable>
    <declare-styleable name="CustomCheckImageView">
        <attr name="checkState" format="boolean" />
        <attr name="checkOn" format="reference"/>
        <attr name="checkOff" format="reference"/>
    </declare-styleable>

    <declare-styleable name="TextLayout">
        <attr name="initX" format="dimension" />
        <attr name="initY" format="dimension" />
        <attr name="xRand" format="dimension" />
        <attr name="animLengthRand" format="dimension" />
        <attr name="xPointFactor" format="dimension" />
        <attr name="animLength" format="dimension" />
        <attr name="heart_width" format="dimension" />
        <attr name="heart_height" format="dimension" />
        <attr name="bezierFactor" format="integer" />
        <attr name="anim_duration" format="integer" />
    </declare-styleable>
    <declare-styleable name="CustomNumberRollingView">
        <!--帧数-->
        <attr name="frameNum" format="integer"></attr>
        <!--内容的格式-->
        <attr name="textType">
            <enum name="money" value="0"></enum>
            <enum name="num" value="1"></enum>
        </attr>
        <!--是否设置每三位数字一个逗号-->
        <attr name="useCommaFormat" format="boolean"></attr>
        <!--是否当内容改变的时候使用动画，反之则不使用动画-->
        <attr name="runWhenChange" format="boolean"></attr>
    </declare-styleable>
    <declare-styleable name="CustomLayoutWithMaxHeight">
        <attr name="maxHeight" format="dimension" />
    </declare-styleable>
    <declare-styleable name="Theme">
        <attr name="markdownStyle" format="reference"/>
    </declare-styleable>
    <declare-styleable name="MarkdownTheme">
        <attr name="h1TextColor" format="color|reference"/>
        <attr name="h6TextColor" format="color|reference"/>
        <attr name="quotaColor" format="color|reference"/>
        <attr name="quotaTextColor" format="color|reference"/>
        <attr name="codeTextColor" format="color|reference"/>
        <attr name="codeBackgroundColor" format="color|reference"/>
        <attr name="linkColor" format="color|reference"/>
        <attr name="underlineColor" format="color|reference"/>
    </declare-styleable>
</resources>