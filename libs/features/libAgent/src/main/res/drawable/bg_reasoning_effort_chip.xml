<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/design_accent_indigo_15" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="@color/design_accent_indigo_border" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/design_publish_input_fill" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="@color/design_border_subtle" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/design_publish_input_fill" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="@color/design_border_subtle" />
        </shape>
    </item>
</selector>
