<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/ai_button_secondary" />
            <stroke android:width="1dp" android:color="@color/colorSplitLine" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/colorBackgroundTertiary" />
            <stroke android:width="1dp" android:color="@color/colorSplitLine" />
        </shape>
    </item>
</selector>
