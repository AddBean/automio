<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#17246BFD" />
            <stroke
                android:width="1dp"
                android:color="#66246BFD" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#1FFFFFFF" />
            <stroke
                android:width="0.5dp"
                android:color="@color/design_border_subtle" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/design_bg_card" />
            <stroke
                android:width="0.5dp"
                android:color="@color/design_border_subtle" />
        </shape>
    </item>
</selector>
