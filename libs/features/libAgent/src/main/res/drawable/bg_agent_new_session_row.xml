<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/design_radius_profile_group" />
            <solid android:color="@color/design_bg_card" />
            <stroke
                android:width="1dp"
                android:color="@color/design_permission_card_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/design_radius_profile_group" />
            <solid android:color="@color/design_permission_card_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/design_permission_card_border" />
        </shape>
    </item>
</selector>
