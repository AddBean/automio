<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/design_spacing_3">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/design_spacing_2"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvModelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/design_text_primary"
            android:textSize="@dimen/design_font_lg"
            android:textStyle="bold"
            tools:text="GPT-4.1 Mini" />

        <TextView
            android:id="@+id/tvModelId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/design_text_muted"
            android:textSize="@dimen/design_font_sm"
            tools:text="gpt-4.1-mini" />

        <TextView
            android:id="@+id/tvModelMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/design_spacing_1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/design_text_tertiary"
            android:textSize="@dimen/design_font_sm"
            app:drawableStartCompat="@drawable/ai_status_indicator_enabled"
            android:drawablePadding="@dimen/design_spacing_2"
            tools:text="可用 · 函数调用 · 视觉 · 128K · 自动发现" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivModelMore"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/ai_ripple_rect"
        android:contentDescription="@string/agent_model_more_actions"
        android:padding="12dp"
        android:src="@drawable/ic_more_vertical"
        android:visibility="gone"
        app:tint="@color/design_text_tertiary"
        tools:visibility="visible" />

</LinearLayout>
