<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="4dp"
    tools:background="@color/colorPrimary">

    <com.hive.views.widgets.CustomRoundImageView
        android:id="@+id/messageImageView"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:image_radius="12dp"
        app:image_type="round"
        tools:background="@color/colorPrimaryLight"
        tools:layout_height="200dp"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/messageInfoLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 思考过程：无背景，左侧细线区分 -->
        <LinearLayout
            android:id="@+id/reasoningLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_agent_chat_reasoning_bar" />

            <TextView
                android:id="@+id/reasoningTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_white_60"
                android:textSize="12sp"
                tools:text="Thinking process..." />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/design_text_slate_200"
            android:textIsSelectable="true"
            android:textSize="15sp"
            tools:text="Assistant reply without bubble background." />
    </LinearLayout>

    <com.wang.avi.AVLoadingIndicatorView
        android:id="@+id/statusIndicator"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        app:indicatorColor="@color/colorAccent"
        app:indicatorName="BallBeatIndicator" />
</LinearLayout>
