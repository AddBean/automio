<?xml version="1.0" encoding="utf-8"?>
<com.hive.views.widgets.UIRoundCornerLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/design_spacing_4"
    android:background="@color/design_permission_card_surface"
    android:orientation="vertical"
    app:rcv_borderColor="@color/design_permission_card_border"
    app:rcv_borderWidth="1dp"
    app:rcv_radius="@dimen/design_radius_profile_group">

    <LinearLayout
        android:id="@+id/llProviderHeader"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/ai_ripple_rect"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/design_spacing_4">

        <ImageView
            android:id="@+id/ivProviderIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_model_default"
            tools:src="@drawable/ic_openai" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/design_spacing_3"
            android:layout_marginEnd="@dimen/design_spacing_2"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProviderName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/design_text_primary"
                android:textSize="@dimen/design_font_xl"
                android:textStyle="bold"
                tools:text="OpenAI" />

            <TextView
                android:id="@+id/tvProviderDes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/design_text_muted"
                android:textSize="@dimen/design_font_sm"
                tools:text="OpenAI-Compatible" />
        </LinearLayout>

        <com.hive.views.widgets.TextDrawableView
            android:id="@+id/tvSettings"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:drawablePadding="@dimen/design_spacing_1"
            android:drawableTint="@color/design_text_muted"
            android:gravity="center_vertical|end"
            android:minWidth="72dp"
            android:text="@string/ai_settings"
            android:textColor="@color/design_text_tertiary"
            android:textSize="@dimen/design_font_sm"
            app:drawableHeight="@dimen/design_profile_chevron_size"
            app:drawableRight="@drawable/setting_arrow"
            app:drawableWidth="@dimen/design_profile_chevron_size" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/public_line_width"
        android:layout_marginHorizontal="@dimen/design_spacing_4"
        android:background="@color/design_profile_divider" />

    <LinearLayout
        android:id="@+id/llModelSummary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/ai_ripple_rect"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/design_spacing_4"
        android:paddingEnd="@dimen/design_spacing_1">

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="6dp"
            android:textColor="@color/design_text_secondary"
            android:textSize="@dimen/design_font_lg"
            app:drawableStartCompat="@drawable/ai_status_indicator_enabled"
            tools:text="已连接" />

        <TextView
            android:id="@+id/tvModelCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/design_spacing_2"
            android:layout_weight="1"
            android:textColor="@color/design_text_tertiary"
            android:textSize="@dimen/design_font_lg"
            tools:text="4 个模型" />

        <ImageView
            android:id="@+id/ivAddModel"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/ai_ripple_rect"
            android:contentDescription="@string/ai_add_model"
            android:padding="13dp"
            android:src="@drawable/add"
            app:tint="@color/design_text_tertiary" />

        <com.hive.views.widgets.TextDrawableView
            android:id="@+id/tvShowModels"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/ai_show_models"
            android:drawableTint="@color/design_text_muted"
            android:gravity="center"
            app:drawableHeight="16dp"
            app:drawableRight="@drawable/icon_arr_down"
            app:drawableWidth="16dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llModelsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/design_linearlayout_divider"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/design_spacing_4"
        android:showDividers="beginning|middle" />

</com.hive.views.widgets.UIRoundCornerLinearLayout>
