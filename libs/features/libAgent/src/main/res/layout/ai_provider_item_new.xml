<?xml version="1.0" encoding="utf-8"?>
<com.hive.views.widgets.UIRoundCornerLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/design_spacing_3"
    android:background="@color/design_permission_card_surface"
    android:orientation="vertical"
    android:padding="@dimen/design_spacing_4"
    app:rcv_borderColor="@color/design_permission_card_border"
    app:rcv_borderWidth="1dp"
    app:rcv_radius="@dimen/design_radius_profile_group">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProviderName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/design_text_primary"
                android:textSize="@dimen/design_font_2xl"
                android:textStyle="bold"
                tools:text="OpenAI" />

            <TextView
                android:id="@+id/tvProviderDes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/design_text_muted"
                android:textSize="@dimen/design_font_lg"
                tools:text="OpenAI-Compatible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSettings"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/ai_button_configured"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingHorizontal="12dp"
            android:text="@string/ai_settings"
            android:textColor="@color/design_text_secondary"
            android:textSize="@dimen/design_font_lg"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llModelSummary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/ai_ripple_rect"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="6dp"
            android:textColor="@color/design_text_secondary"
            android:textSize="@dimen/design_font_lg"
            app:drawableStartCompat="@drawable/ai_status_indicator_enabled"
            tools:text="已连接" />

        <TextView
            android:id="@+id/tvModelCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/design_text_tertiary"
            android:textSize="@dimen/design_font_lg"
            tools:text="4 个模型" />

        <ImageView
            android:id="@+id/ivAddModel"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/ai_ripple_rect"
            android:contentDescription="@string/ai_add_model"
            android:padding="11dp"
            android:src="@drawable/add"
            app:tint="@color/design_text_tertiary" />

        <com.hive.views.widgets.TextDrawableView
            android:id="@+id/tvShowModels"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/ai_show_models"
            android:drawableTint="@color/colorAccent"
            android:gravity="center"
            app:drawableHeight="16dp"
            app:drawableRight="@drawable/icon_arr_down"
            app:drawableWidth="16dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llModelsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</com.hive.views.widgets.UIRoundCornerLinearLayout>
