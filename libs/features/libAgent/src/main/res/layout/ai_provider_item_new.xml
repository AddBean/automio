<?xml version="1.0" encoding="utf-8"?>
<com.hive.views.widgets.UIRoundCornerLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/design_spacing_3"
    android:background="@color/design_permission_card_surface"
    android:orientation="vertical"
    android:padding="@dimen/design_spacing_4"
    app:rcv_borderColor="@color/design_permission_card_border"
    app:rcv_borderWidth="1dp"
    app:rcv_radius="@dimen/design_radius_profile_group"
    tools:background="@color/design_bg_overlay">

    <!-- Provider 头部 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="@dimen/design_spacing_3">

            <TextView
                android:id="@+id/tvProviderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/design_text_primary"
                android:textSize="@dimen/design_font_2xl"
                android:textStyle="bold"
                tools:text="OpenAI" />

            <TextView
                android:id="@+id/tvProviderDes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/design_text_muted"
                android:textSize="@dimen/design_font_lg"
                tools:text="LLM • OpenAI-Compatible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ai_button_configured"
            android:paddingHorizontal="@dimen/design_spacing_3"
            android:paddingVertical="@dimen/design_spacing_1_5"
            android:text="@string/ai_settings"
            android:textColor="@color/design_text_secondary"
            android:textSize="@dimen/design_font_lg"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/public_line_width"
        android:layout_marginTop="@dimen/design_spacing_3"
        android:layout_marginBottom="@dimen/design_spacing_3"
        android:background="@color/design_profile_divider" />

    <!-- 模型信息行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvModelCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/design_text_tertiary"
            android:textSize="@dimen/design_font_lg"
            tools:text="3 models" />

        <ImageView
            android:id="@+id/ivAddModel"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/ai_ripple_rect"
            android:padding="5dp"
            android:src="@drawable/add"
            app:tint="@color/design_text_tertiary" />

        <com.hive.views.widgets.TextDrawableView
            android:id="@+id/tvShowModels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/design_spacing_2"
            android:drawablePadding="2dp"
            android:drawableTint="@color/colorAccent"
            android:paddingVertical="@dimen/design_spacing_1"
            android:text="@string/ai_show_models"
            android:textColor="@color/colorAccent"
            android:textSize="@dimen/design_font_lg"
            android:textStyle="bold"
            app:drawableHeight="14dp"
            app:drawableRight="@drawable/icon_arr_down"
            app:drawableWidth="14dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llModelsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/design_spacing_2"
        android:orientation="vertical" />

</com.hive.views.widgets.UIRoundCornerLinearLayout>
