<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="6dp"
    tools:background="@color/colorPrimary">

    <LinearLayout
        android:id="@+id/toolHeaderContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_agent_chat_tool_chip"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_tool"
            android:tint="@color/text_white_60" />

        <TextView
            android:id="@+id/toolTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="220dp"
            android:text="@string/agent_tool_call"
            android:textColor="@color/design_text_slate_200"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/toolStatusImageView"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:contentDescription="@string/agent_tool_executing" />

    </LinearLayout>

</LinearLayout>
