<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp"
    tools:background="@color/colorPrimary">

    <TextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 工具调用主容器 -->
    <LinearLayout
        android:id="@+id/toolHeaderContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/tool_message_container_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/toolResultExpandIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_expand_more"
                app:tint="@color/design_text_slate_400" />

            <TextView
                android:id="@+id/toolTitleTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/agent_tool_call"
                android:textColor="@color/design_text_slate_400"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/toolStatusImageView"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/agent_tool_executing" />


        </LinearLayout>


        <!-- 工具调用详情（可折叠） -->
        <LinearLayout
            android:id="@+id/toolDetailContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/tool_detail_bg"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- 工具方法名 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="@string/agent_tool_method"
                    android:textColor="@color/design_text_slate_400"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/toolMethodTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="@color/design_text_slate_300"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- 工具参数 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="@string/agent_tool_parameters"
                    android:textColor="@color/design_text_slate_400"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/toolArgumentsTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/design_text_slate_300"
                    android:textSize="11sp" />

            </LinearLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:text="@string/agent_tool_execution_result"
                android:textColor="@color/design_text_slate_400"
                android:textSize="11sp" />

            <!-- 工具附件图片 -->
            <com.hive.views.widgets.UIRoundCornerImageView
                android:id="@+id/toolMessageImageView"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:adjustViewBounds="true"
                android:visibility="gone"
                app:rcv_borderColor="@color/colorSplitLine"
                app:rcv_borderWidth="1dp"
                app:rcv_radius="8dp"
                tools:src="@drawable/ai_model_item_bg"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/toolResultTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/tool_result_bg"
                android:fontFamily="monospace"
                android:scrollbars="vertical"
                android:textColor="@color/design_text_slate_300"
                android:textSize="11sp"
                tools:text="----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------" />

        </LinearLayout>

    </LinearLayout>


</LinearLayout> 
