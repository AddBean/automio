<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingVertical="2dp"
    tools:background="@color/colorPrimary">

    <!-- 紧凑工具 chip：仅工具名 + 状态，宽度包裹内容 -->
    <LinearLayout
        android:id="@+id/toolHeaderContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/tool_message_container_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/toolTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/agent_tool_call"
            android:textColor="@color/design_text_slate_400"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/toolStatusImageView"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@string/agent_tool_executing" />

    </LinearLayout>

</LinearLayout>
