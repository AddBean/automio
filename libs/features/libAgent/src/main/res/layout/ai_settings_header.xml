<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:background="@color/design_bg_overlay">

    <!-- Models -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/design_spacing_3"
        android:letterSpacing="0.12"
        android:text="@string/agent_model_section_models"
        android:textAllCaps="true"
        android:textColor="@color/design_text_muted"
        android:textSize="@dimen/design_font_xs"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_agent_tool_section"
        android:orientation="vertical"
        android:paddingVertical="4dp">

        <LinearLayout
            android:id="@+id/rowNormalInference"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/ai_ripple_rect"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_brain"
                app:tint="@color/design_text_tertiary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNormalInference"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agent_normal_model"
                    android:textColor="@color/design_text_primary"
                    android:textSize="@dimen/design_font_lg"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNormalDes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:text="@string/agent_settings_not_set"
                    android:textColor="@color/design_accent_rose"
                    android:textSize="@dimen/design_font_sm"
                    tools:text="GPT-4o" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null"
                android:src="@drawable/setting_arrow"
                app:tint="@color/design_text_muted" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/public_line_width"
            android:layout_marginHorizontal="14dp"
            android:background="@color/design_profile_divider" />

        <LinearLayout
            android:id="@+id/rowMultimodalInference"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/ai_ripple_rect"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_image"
                app:tint="@color/design_text_tertiary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMultimodalInference"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agent_multimodal_model"
                    android:textColor="@color/design_text_primary"
                    android:textSize="@dimen/design_font_lg"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMultimodalDes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:text="@string/agent_settings_not_set"
                    android:textColor="@color/design_accent_rose"
                    android:textSize="@dimen/design_font_sm" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null"
                android:src="@drawable/setting_arrow"
                app:tint="@color/design_text_muted" />
        </LinearLayout>
    </LinearLayout>

    <!-- Capabilities -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/design_spacing_8"
        android:layout_marginBottom="@dimen/design_spacing_3"
        android:letterSpacing="0.12"
        android:text="@string/agent_model_section_capabilities"
        android:textAllCaps="true"
        android:textColor="@color/design_text_muted"
        android:textSize="@dimen/design_font_xs"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_agent_tool_section"
        android:orientation="vertical"
        android:paddingVertical="4dp">

        <LinearLayout
            android:id="@+id/rowVisionRecognition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_eye"
                app:tint="@color/design_text_tertiary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvVisionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agent_vision_recognition_title"
                    android:textColor="@color/design_text_primary"
                    android:textSize="@dimen/design_font_lg"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVisionDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:text="@string/agent_vision_recognition_desc"
                    android:textColor="@color/design_text_tertiary"
                    android:textSize="@dimen/design_font_sm" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchVisionRecognition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/public_line_width"
            android:layout_marginHorizontal="14dp"
            android:background="@color/design_profile_divider" />

        <LinearLayout
            android:id="@+id/rowReasoningSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_brain"
                app:tint="@color/design_text_tertiary" />

            <LinearLayout
                android:id="@+id/reasoningSwitchLabels"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReasoningTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agent_reasoning_switch_title"
                    android:textColor="@color/design_text_primary"
                    android:textSize="@dimen/design_font_lg"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReasoningDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="3"
                    android:text="@string/agent_reasoning_switch_desc"
                    android:textColor="@color/design_text_tertiary"
                    android:textSize="@dimen/design_font_sm" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchReasoning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/agent_reasoning_switch_cd" />
        </LinearLayout>

        <View
            android:id="@+id/dividerReasoningEffort"
            android:layout_width="match_parent"
            android:layout_height="@dimen/public_line_width"
            android:layout_marginHorizontal="14dp"
            android:background="@color/design_profile_divider" />

        <LinearLayout
            android:id="@+id/rowReasoningEffort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tvReasoningEffortTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/agent_reasoning_effort_title"
                android:textColor="@color/design_text_primary"
                android:textSize="@dimen/design_font_lg"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutReasoningEffortOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnReasoningEffortLow"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_reasoning_effort_chip"
                    android:gravity="center"
                    android:text="@string/agent_reasoning_effort_low"
                    android:textColor="@color/design_text_secondary"
                    android:textSize="@dimen/design_font_sm" />

                <TextView
                    android:id="@+id/btnReasoningEffortMedium"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_reasoning_effort_chip"
                    android:gravity="center"
                    android:text="@string/agent_reasoning_effort_medium"
                    android:textColor="@color/design_text_secondary"
                    android:textSize="@dimen/design_font_sm" />

                <TextView
                    android:id="@+id/btnReasoningEffortHigh"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_reasoning_effort_chip"
                    android:gravity="center"
                    android:text="@string/agent_reasoning_effort_high"
                    android:textColor="@color/design_text_secondary"
                    android:textSize="@dimen/design_font_sm" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/public_line_width"
            android:layout_marginHorizontal="14dp"
            android:background="@color/design_profile_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_model_default"
                app:tint="@color/design_text_tertiary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTaskMemoryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agent_task_memory_switch_title"
                    android:textColor="@color/design_text_primary"
                    android:textSize="@dimen/design_font_lg"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTaskMemoryDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:text="@string/agent_task_memory_switch_desc"
                    android:textColor="@color/design_text_tertiary"
                    android:textSize="@dimen/design_font_sm" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchTaskMemory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Service settings entry (sheet only) -->
    <LinearLayout
        android:id="@+id/rowServiceSettings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/design_spacing_8"
        android:background="@drawable/bg_agent_tool_section"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_home"
            app:tint="@color/design_text_tertiary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/agent_model_service_settings_entry"
            android:textColor="@color/design_text_primary"
            android:textSize="@dimen/design_font_lg"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/setting_arrow"
            app:tint="@color/design_text_muted" />
    </LinearLayout>

</LinearLayout>
