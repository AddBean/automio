<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="7dp"
    android:paddingTop="6dp"
    android:paddingEnd="36dp"
    android:paddingBottom="7dp"
    tools:background="@color/colorPrimary">


    <TextView
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/colorTextSecondary"
        android:textSize="8sp"
        tools:text="10:30:30" />

    <com.hive.views.widgets.TextDrawableView
        android:id="@+id/tv_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_toEndOf="@id/tv_name"
        android:drawablePadding="2dp"
        android:gravity="center_vertical"
        android:textColor="@color/colorAccent"
        android:textSize="11sp"
        app:drawableHeight="9dp"
        app:drawableLeft="@drawable/icon_logger_play"
        app:drawableTint="@color/colorAccent"
        app:drawableWidth="9dp"
        tools:text="这是测试" />

    <com.hive.views.widgets.AutoLinkTextView
        android:id="@+id/tv_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_tag"
        android:layout_alignStart="@id/tv_tag"
        android:autoLink="all"
        android:layout_marginTop="1dp"
        android:textColor="@color/colorTextSecondary"
        android:textSize="10sp"
        android:visibility="gone"
        tools:text="测试测试测试测试测试测试测试测试测试测试测试测试测试测试测试测试测试测试测试测试测试测试测试测试测试测试测试测试测试测试测试测试测试测试"
        tools:visibility="visible" />
</RelativeLayout>