<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    tools:background="@color/colorPrimaryLight">

    <TextView
        android:id="@+id/tv_title"
        style="@style/base.content.title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginLeft="12dp"
        android:text="设置标题"
        android:textSize="14sp" />


    <com.hive.script.views.widgets.ScriptSizeSeekbarView
        android:id="@+id/seek_view"
        android:layout_width="160dp"
        android:layout_height="36dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_gravity="center"
        android:gravity="center"
        android:paddingStart="2dp"
        android:paddingTop="2dp"
        android:paddingEnd="0dp"
        android:paddingBottom="2dp" />

    <View
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@id/seek_view"
        android:layout_alignTop="@id/seek_view"
        android:layout_alignEnd="@id/seek_view"
        android:layout_alignBottom="@id/seek_view"
        android:layout_marginEnd="10dp"
        android:background="@drawable/xml_round_line_dark_bg" />
</RelativeLayout>