<?xml version="1.0" encoding="utf-8"?>
<com.hive.views.StatefulLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_state"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    app:defState="progress"
    app:emptyLayout="@layout/script_manager_list_empty"
    app:emptyText="@string/script_manager_list_empty"
    tools:background="@color/colorPrimary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="4dp"
        android:clickable="true"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="4dp"
            android:paddingRight="4dp">

            <FrameLayout
                android:id="@+id/layout_title"
                android:layout_width="match_parent"
                android:layout_height="48dp">

                <com.hive.views.widgets.TextDrawableView
                    android:id="@+id/tv_filter_title"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:drawablePadding="2dp"
                    android:drawableTint="@color/colorTextSecondary"
                    android:gravity="center_vertical"
                    android:paddingLeft="12dp"
                    android:text="@string/sc_script_list_title_default"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="14sp"
                    app:drawableHeight="14dp"
                    app:drawableRight="@drawable/icon_arr_down"
                    app:drawableWidth="14dp" />

                <com.hive.views.widgets.TextDrawableView
                    android:id="@+id/btn_import"
                    style="@style/base.content.title"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="right"
                    android:layout_marginTop="3dp"
                    android:layout_marginRight="40dp"
                    android:gravity="center"
                    android:padding="10dp"
                    android:src="@drawable/icon_close"
                    android:text="@string/sc_list_item_import"
                    android:textColor="@color/colorAccent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.hive.views.widgets.TextDrawableView
                    android:id="@+id/btn_edit"
                    style="@style/base.content.title"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="right"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:padding="10dp"
                    android:src="@drawable/icon_close"
                    android:text="@string/sc_list_item_edit"
                    android:textColor="@color/colorAccent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/iv_close"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="right"
                    android:layout_marginTop="3dp"
                    android:padding="14dp"
                    android:src="@drawable/icon_close"
                    android:tint="@color/color_black"
                    android:visibility="gone" />
            </FrameLayout>

            <include
                android:id="@+id/layout_edit_opt"
                layout="@layout/sc_list_edit_opt_layout"
                android:visibility="gone" />

        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/public_line_width"
            android:alpha="0.6"
            android:background="@color/colorSplitLine" />

        <com.hive.views.list_view.ListRecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="8dp"
            tools:itemCount="2"
            tools:listitem="@layout/fragment_script_item_layout" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/public_line_width"
            android:background="@color/colorSplitLine" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <com.hive.views.widgets.TextDrawableView
                android:id="@+id/layoutTaskAdd"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal|bottom"
                android:background="@drawable/xml_btn_accent_round_bg"
                android:drawablePadding="6dp"
                android:drawableTint="@color/colorTextSecondary"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="@string/task_add"
                android:textColor="@color/colorTextSecondary"
                android:textSize="14sp"
                app:drawableHeight="14dp"
                app:drawableLeft="@drawable/icon_plus_thin"
                app:drawableWidth="14dp" />
        </LinearLayout>

    </LinearLayout>

</com.hive.views.StatefulLayout>
