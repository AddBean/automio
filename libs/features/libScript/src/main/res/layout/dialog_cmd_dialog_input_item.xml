<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp"
    android:paddingStart="20dp"
    android:paddingEnd="16dp"
    tools:background="@color/colorPrimary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_dialog_label"
            android:textColor="@color/textColorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_required"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/required_asterisk"
            android:textColor="#FF4444"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Switch
            android:id="@+id/switch_input"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_black"
            android:textSize="14sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/xml_edit_text_bg"
        android:hint="@string/ui_dialog_input_hint"
        android:inputType="text"
        android:maxLines="1"
        android:minHeight="40dp"
        android:paddingVertical="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/textColorPrimary"
        android:textColorHint="@color/colorTextSecondary2"
        android:textSize="15sp" />


    <com.hive.script.views.widgets.ScriptValueView
        android:id="@+id/param_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/xml_edit_text_bg"
        app:scriptValueEditEnable="false"
        app:scriptValueName="@string/script_select_parameter"
        app:scriptValueTextColor="@color/colorAccent" />

</LinearLayout> 