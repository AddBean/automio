<?xml version="1.0" encoding="utf-8"?>
<com.hive.views.StatefulLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_state"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    app:defState="progress"
    app:emptyLayout="@layout/script_manager_list_empty"
    app:emptyText="@string/script_manager_list_empty">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/xml_common_dialog_round_bottom_bg"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingTop="40dp"
        android:tag="ScriptDialog">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/layout_title"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_gravity="center_vertical">

                <com.hive.views.widgets.TextDrawableView
                    android:id="@+id/tv_filter_title"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="20dp"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/textColorPrimary"
                    android:gravity="center_vertical"
                    android:text="@string/sc_script_list_title_default"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:drawableHeight="16dp"
                    app:drawableRight="@drawable/sc_icon_arr_down"
                    app:drawableWidth="16dp" />

                <com.hive.views.widgets.TextDrawableView
                    android:id="@+id/btn_import"
                    style="@style/base.content.title"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="80dp"
                    android:gravity="center"
                    android:padding="10dp"
                    android:src="@drawable/icon_close"
                    android:text="@string/sc_list_item_import"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.hive.views.widgets.TextDrawableView
                    android:id="@+id/btn_edit"
                    style="@style/base.content.title"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="40dp"
                    android:gravity="center"
                    android:padding="10dp"
                    android:src="@drawable/icon_close"
                    android:text="@string/sc_list_item_edit"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/iv_close"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:padding="14dp"
                    android:src="@drawable/icon_close"
                    app:tint="@color/textColorPrimary" />
            </FrameLayout>

            <include
                android:id="@+id/layout_edit_opt"
                layout="@layout/sc_list_edit_opt_layout"
                android:visibility="gone" />

        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/public_line_width"
            android:background="@color/black" />

        <com.hive.views.list_view.ListRecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            tools:itemCount="2"
            tools:listitem="@layout/fragment_script_item_layout" />
    </LinearLayout>

</com.hive.views.StatefulLayout>