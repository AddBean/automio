<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/xml_elegant_card_bg2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 标题栏 -->
        <LinearLayout
            android:id="@+id/layoutHeaderDrag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/ivDragHandle"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:padding="2dp"
                android:src="@drawable/sc_ic_drag"
                android:tint="@color/tech_cyan" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/ui_param_input"
                android:textColor="@color/tech_cyan"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivDelete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/icon_timer_delete" />
        </LinearLayout>

        <!-- 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:background="@color/tech_border" />
        <!-- 参数名称 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="@string/ui_param_name"
                android:textColor="@color/tech_cyan_light"
                android:textSize="14sp" />

            <com.hive.views.widgets.RoundFrameLayout
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                app:round_view_radius="6dp"
                app:view_draw_paint_color="@color/tech_blue_accent">

                <com.hive.script.views.widgets.ScriptSpanParamTextView
                    android:id="@+id/tvParamName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/tech_blue_secondary"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="14sp"
                    tools:text="参数名称" />
            </com.hive.views.widgets.RoundFrameLayout>
        </LinearLayout>
        <!-- 参数ID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="@string/ui_param_select"
                android:textColor="@color/tech_cyan_light"
                android:textSize="14sp" />

            <com.hive.views.widgets.RoundFrameLayout
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                app:round_view_radius="6dp"
                app:view_draw_paint_color="@color/tech_blue_accent">

                <com.hive.script.views.widgets.ScriptSpanParamTextView
                    android:id="@+id/tvParamId"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/tech_blue_secondary"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="14sp"
                    tools:text="param_id" />
            </com.hive.views.widgets.RoundFrameLayout>
        </LinearLayout>


        <!-- 提示文本 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="@string/ui_param_hint"
                android:textColor="@color/tech_cyan_light"
                android:textSize="14sp" />

            <com.hive.views.widgets.RoundFrameLayout
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                app:round_view_radius="6dp"
                app:view_draw_paint_color="@color/tech_blue_accent">

                <com.hive.script.views.widgets.ScriptSpanParamTextView
                    android:id="@+id/tvParamHint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/tech_blue_secondary"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="14sp"
                    tools:text="请输入参数" />
            </com.hive.views.widgets.RoundFrameLayout>
        </LinearLayout>

        <!-- 默认值 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="@string/ui_param_default"
                android:textColor="@color/tech_cyan_light"
                android:textSize="14sp" />

            <com.hive.views.widgets.RoundFrameLayout
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                app:round_view_radius="6dp"
                app:view_draw_paint_color="@color/tech_blue_accent">

                <com.hive.script.views.widgets.ScriptSpanParamTextView
                    android:id="@+id/tvParamDefault"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/tech_blue_secondary"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="14sp"
                    tools:text="默认值" />
            </com.hive.views.widgets.RoundFrameLayout>
        </LinearLayout>

        <!-- 必填选项 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_param_required"
                android:textColor="@color/tech_cyan_light"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchRequired"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:theme="@style/SwitchCompatTheme" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
