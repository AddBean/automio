<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.hive.script.views.widgets.ScriptFloatView
        android:id="@+id/number_duration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:optFloatInput="true"
        app:optFloatMax="3600"
        app:optFloatMin="0.01"
        app:optFloatType="TYPE2"
        app:optFloatUnit="@string/sc_unit_s"
        app:scriptFloatEnable="true"
        app:scriptFloatMaxDigits="2"
        app:scriptFloatRatio="1000"
        app:scriptFloatName="@string/sc_cmd_duration" />
</LinearLayout>