<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="4dp"
    android:layout_marginTop="2dp"
    android:layout_marginRight="4dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/xml_condition_content_item_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <com.hive.script.views.widgets.ScriptSpanMenuView
        android:id="@+id/conditionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:lineSpacingMultiplier="1.4"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp"
        tools:text="TextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextViewTextView" />

    <ImageView
        android:id="@+id/ivDelete"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="end"
        android:alpha="0.8"
        android:background="@drawable/xml_btn_close_round_bg"
        android:padding="4dp"
        android:src="@drawable/ic_close_common"
        app:tint="@color/white" />
</FrameLayout>