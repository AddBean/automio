<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="2dp"
    android:paddingEnd="8dp"
    android:paddingBottom="2dp"
    tools:background="@color/colorPrimary">

    <com.hive.views.widgets.RoundFrameLayout
        android:id="@+id/leftLayout"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_weight="1"
        app:round_view_radius="6dp"
        app:view_draw_paint_color="@color/colorPrimaryLight">

        <com.hive.script.views.widgets.ScriptSpanParamTextView
            android:id="@+id/leftValue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorSplitLine"
            android:gravity="center"
            android:imeOptions="actionDone"
            android:minWidth="80dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:singleLine="true"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            tools:text="KEY" />
    </com.hive.views.widgets.RoundFrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="3dp"
        android:gravity="center"
        android:text=":"
        android:textColor="@color/colorTextSecondary"
        android:textSize="20dp" />

    <com.hive.views.widgets.RoundFrameLayout
        android:id="@+id/rightLayout"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1.5"
        app:round_view_radius="6dp"
        app:view_draw_paint_color="@color/colorPrimaryLight">

        <com.hive.script.views.widgets.ScriptSpanParamTextView
            android:id="@+id/rightValue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorSplitLine"
            android:gravity="center"
            android:imeOptions="actionDone"
            android:minWidth="80dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:singleLine="true"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            tools:text="VALUE
" />

    </com.hive.views.widgets.RoundFrameLayout>

    <ImageView
        android:id="@+id/ivDelete"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:padding="6dp"
        android:src="@drawable/icon_timer_delete" />
</LinearLayout>