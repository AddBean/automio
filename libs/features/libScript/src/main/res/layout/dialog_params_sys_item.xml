<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:background="@color/colorPrimary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:background="@drawable/xml_round_dark_bg"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.hive.views.widgets.RectRoundImageView
                android:id="@+id/viewSysBg"
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:round_view_radius="8dp"
                app:round_view_type="round"
                app:view_draw_paint_color="#06060A" />

            <TextView
                android:id="@+id/tvParamSysName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:singleLine="true"
                android:textColor="@color/colorTextSecondary"
                android:textSize="14sp"
                tools:text="testtest" />


            <ImageView
                android:id="@+id/editSysIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="12dp"
                android:src="@drawable/script_edit"
                android:tint="@color/colorTextSecondary" />

            <TextView
                android:id="@+id/paramSysType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="60dp"
                android:gravity="end"
                android:textSize="11sp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textColor="@color/colorTextSecondary2"
                android:text="@string/param_read_only"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="8dp"
            android:background="@color/colorSplitLine" />

        <TextView
            android:id="@+id/paramSysDes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginEnd="36dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="30dp"
            android:gravity="center_vertical|start"
            android:textColor="@color/colorTextSecondary2"
            android:textSize="13sp"
            tools:text="testtest" />
    </LinearLayout>

</FrameLayout>