<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:orientation="vertical"
    tools:background="@color/colorPrimary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:background="@drawable/xml_round_dark_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.hive.views.widgets.RectRoundImageView
            android:id="@+id/viewBg"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            app:round_view_radius="8dp"
            app:round_view_type="round"
            app:view_draw_paint_color="#06060A" />

        <TextView
            android:id="@+id/tvParamName"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp"
            tools:text="testtesttesttesttesttesttesttesttesttesttesttesttesttesttesttest" />


        <ImageView
            android:id="@+id/editIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="12dp"
            android:src="@drawable/script_edit"
            android:tint="@color/colorTextSecondary" />
    </LinearLayout>

</FrameLayout>