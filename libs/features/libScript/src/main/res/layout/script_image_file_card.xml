<?xml version="1.0" encoding="utf-8"?>
<com.hive.views.widgets.RectRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="1dp"
    android:background="@color/black"
    android:gravity="center"
    android:orientation="vertical"
    app:rectRate="1"
    tools:parentTag="android.widget.RelativeLayout">

    <ImageView
        android:id="@+id/iv_plus"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_centerInParent="true"
        android:src="@drawable/icon_plus_thin" />

    <FrameLayout
        android:id="@+id/fl_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true" />

        <ImageView
            android:id="@+id/iv_checkbox"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:layout_gravity="top|right"
            android:src="@drawable/img_checkbox_bg" />
    </FrameLayout>


</com.hive.views.widgets.RectRelativeLayout>