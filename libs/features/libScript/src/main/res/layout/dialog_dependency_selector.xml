<?xml version="1.0" encoding="utf-8"?>
<!-- 依赖选择器主布局（对齐 script-design DependencySelectSheet.tsx: h-3/4 rounded-t-[28px]） -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000">

    <!-- 主内容容器：高度动态设置为屏幕 75% -->
    <LinearLayout
        android:id="@+id/layout_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_dependency_selector"
        android:clickable="true"
        android:elevation="8dp"
        android:orientation="vertical"
        android:tag="ScriptDialog">

        <!-- 顶部指示条 -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/design_drag_handle_bg" />

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="12dp"
            android:text="@string/sc_export_dependency_title"
            android:textColor="@color/design_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Tab 切换容器 -->
        <LinearLayout
            android:id="@+id/layout_tab_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/design_tab_container_bg"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tab_dependency"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/design_tab_active_bg"
                android:gravity="center"
                android:text="@string/sc_export_dependency_tab_resources"
                android:textColor="@color/design_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_permission"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center"
                android:text="@string/sc_export_dependency_tab_permissions"
                android:textColor="@color/design_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 提示文字（无依赖时显示） -->
        <TextView
            android:id="@+id/tv_permission_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/sc_export_dependency_select_permissions"
            android:textColor="@color/design_text_muted"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- 内容区域 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp"
            android:scrollbars="vertical" />

        <!-- 底部按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/design_btn_secondary_bg"
                android:gravity="center"
                android:text="@string/cancel"
                android:textColor="@color/design_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_confirm"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/design_btn_primary_bg"
                android:gravity="center"
                android:text="@string/sc_export_dependency_confirm_publish"
                android:textColor="@color/design_text_on_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>