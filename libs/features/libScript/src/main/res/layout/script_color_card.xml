<?xml version="1.0" encoding="utf-8"?>
<com.hive.views.widgets.RectRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="42dp"
    android:layout_height="42dp"
    android:gravity="center"
    android:orientation="vertical"
    app:rectRate="1"
    tools:parentTag="android.widget.RelativeLayout">

    <com.hive.views.widgets.RoundFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        app:round_view_type="circle"
        app:view_draw_paint_color="@color/colorPrimaryLight">

        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:background="@color/black"
            android:foreground="@drawable/xml_color_selector_fg"
            android:scaleType="centerCrop"
            app:image_type="circle" />
    </com.hive.views.widgets.RoundFrameLayout>


</com.hive.views.widgets.RectRelativeLayout>