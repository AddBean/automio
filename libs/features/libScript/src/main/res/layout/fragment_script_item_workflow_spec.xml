<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/script_workflow_card_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    tools:background="@color/script_workflow_bg_card">

    <LinearLayout
        android:id="@+id/layout_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.hive.views.widgets.UIResourceIconView
            android:id="@+id/icon_workflow"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:ri_resourceType="workflow" />

        <!-- Web: max-w-[160px] 文本列 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/str_task_name"
                android:textColor="@color/script_workflow_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Workflow name" />

            <LinearLayout
                android:id="@+id/layout_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:background="@drawable/script_workflow_status_bg"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:minWidth="58dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/script_state_running"
                    android:textColor="@color/script_workflow_status_text_idle"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:background="@drawable/script_workflow_status_running_bg"
                    tools:text="Running" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/script_workflow_text_desc"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="Description"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/ivPlay"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/script_workflow_play_circle_bg"
            android:scaleType="fitCenter"
            android:src="@drawable/script_workflow_play_pause_selector" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivMore"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/editor_more"
            android:tint="@color/script_workflow_emerald_muted"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/layout_right"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/switch_check"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:clickable="false"
                android:padding="6dp"
                android:src="@drawable/xml_selector_drawable"
                android:tint="@color/colorAccent"
                android:visibility="visible" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_script_item_extra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="12dp"
            android:background="@color/colorSplitLine" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.hive.views.widgets.TextDrawableView
                    android:id="@+id/tvLock"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="18dp"
                    android:drawablePadding="2dp"
                    android:drawableTint="@color/colorTextSecondary"
                    android:gravity="center_vertical"
                    android:text="@string/sc_item_edit_lock"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="12sp"
                    app:drawableHeight="13dp"
                    app:drawableLeft="@drawable/sc_lock"
                    app:drawableWidth="13dp" />

                <com.hive.views.widgets.TextDrawableView
                    android:id="@+id/tvExpire"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="16dp"
                    android:drawablePadding="2dp"
                    android:drawableTint="@color/colorTextSecondary"
                    android:gravity="center_vertical"
                    android:text="@string/sc_item_edit_expire_time"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="12sp"
                    app:drawableHeight="13dp"
                    app:drawableLeft="@drawable/sc_expired"
                    app:drawableWidth="13dp" />

                <com.hive.views.widgets.TextDrawableView
                    android:id="@+id/tvShare"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="16dp"
                    android:drawablePadding="2dp"
                    android:drawableTint="@color/colorTextSecondary"
                    android:gravity="center_vertical"
                    android:text="@string/sc_item_edit_share"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="12sp"
                    app:drawableHeight="13dp"
                    app:drawableLeft="@drawable/sc_icon_share"
                    app:drawableWidth="13dp" />

                <com.hive.views.widgets.TextDrawableView
                    android:id="@+id/tvEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="16dp"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/colorTextSecondary"
                    android:gravity="center_vertical"
                    android:paddingEnd="6dp"
                    android:text="@string/sc_item_edit_name"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="12sp"
                    app:drawableHeight="12dp"
                    app:drawableLeft="@drawable/script_edit"
                    app:drawableWidth="12dp"
                    tools:ignore="RtlSymmetry" />

                <com.hive.views.widgets.TextDrawableView
                    android:id="@+id/tvPublish"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="16dp"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/colorTextSecondary"
                    android:gravity="center_vertical"
                    android:paddingEnd="6dp"
                    android:text="@string/sc_item_publish_name"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="12sp"
                    app:drawableHeight="12dp"
                    app:drawableLeft="@drawable/ic_publish"
                    app:drawableWidth="12dp"
                    tools:ignore="RtlSymmetry" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
