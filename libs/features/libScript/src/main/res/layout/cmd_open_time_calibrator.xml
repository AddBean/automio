<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:background="@color/colorPrimaryLight">

    <com.hive.script.views.widgets.ScriptValueView
        android:id="@+id/time_type_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:scriptValueEditEnable="false"
        app:scriptValueName="@string/sc_cmd_open_time_calibrator"
        app:scriptValueTextColor="@color/colorAccent" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:lineSpacingMultiplier="1.2"
        android:text="@string/sc_cmd_open_time_calibrator_msg"
        android:textColor="@color/colorTextSecondary"
        android:textSize="14sp" />
</LinearLayout>