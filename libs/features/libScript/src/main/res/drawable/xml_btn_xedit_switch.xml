<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/colorPrimary" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <item android:bottom="4dp" android:gravity="right" android:left="46dp" android:right="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/colorAccent" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <item android:bottom="12dp" android:drawable="@drawable/sc_icon_list" android:width="26dp" android:height="26dp" android:left="54dp" android:right="12dp" android:top="12dp" />
        </layer-list>

    </item>

    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/colorPrimary" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <item android:bottom="4dp" android:gravity="left" android:left="4dp" android:right="46dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/colorAccent" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <item android:bottom="12dp" android:drawable="@drawable/sc_icon_tree" android:width="26dp" android:height="26dp" android:left="12dp" android:right="54dp" android:top="12dp" />
        </layer-list>

    </item>
</selector>