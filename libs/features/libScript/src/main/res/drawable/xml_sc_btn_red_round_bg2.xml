<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="false">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#E9463C"
                android:centerColor="#F05A4C"
                android:endColor="#E9463C"
                android:type="linear" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#D13A30" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#D13A30"
                android:centerColor="#E9463C"
                android:endColor="#D13A30"
                android:type="linear" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#B82A20" />
        </shape>
    </item>
</selector>