<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <!-- Shadow -->
            <item android:right="1dp" android:top="1dp">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="#00000000" />
                            <padding android:bottom="7px" android:left="7px" android:right="7px" android:top="7px" />
                            <corners android:radius="6dp" />
                        </shape>
                    </item>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="#02000000" />
                            <padding android:bottom="6px" android:left="6px" android:right="6px" android:top="6px" />
