                        </shape>
                    </item>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="#03000000" />
                            <padding android:bottom="5px" android:left="5px" android:right="5px" android:top="5px" />
                            <corners android:radius="6dp" />
                        </shape>
                    </item>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="#04000000" />
                            <padding android:bottom="4px" android:left="4px" android:right="4px" android:top="4px" />
                            <corners android:radius="6dp" />
                        </shape>
                    </item>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="#05000000" />
