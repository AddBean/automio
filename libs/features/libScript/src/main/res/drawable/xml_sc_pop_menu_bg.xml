                            <corners android:radius="6dp" />
                        </shape>
                    </item>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="#07000000" />
                            <padding android:bottom="1px" android:left="1px" android:right="1px" android:top="1px" />
                            <corners android:radius="6dp" />
                        </shape>
                    </item>
                </layer-list>
            </item>

            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#ff000000" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>