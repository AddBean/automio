<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 阴影层 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    
    <!-- 主背景层 -->
    <item android:left="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/tech_gradient_start"
                android:centerColor="@color/tech_gradient_center"
                android:endColor="@color/tech_gradient_end"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/tech_border" />
        </shape>
    </item>
    
</layer-list> 