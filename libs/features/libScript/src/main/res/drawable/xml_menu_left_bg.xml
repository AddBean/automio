<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="false">
        <shape android:shape="rectangle">
            <corners android:bottomLeftRadius="12dp" android:bottomRightRadius="0dp" android:topLeftRadius="12dp" android:topRightRadius="0dp" />
            <gradient
                android:angle="135"
                android:startColor="@color/tech_gradient_start"
                android:centerColor="@color/tech_gradient_center"
                android:endColor="@color/tech_gradient_end"
                android:type="linear" />
            <stroke android:width="1.5dp" android:color="@color/tech_border" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent" />
        </shape>
    </item>
</selector>