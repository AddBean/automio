<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#12161D"
                android:startColor="#101C31" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#1F6FADE8" />
        </shape>
    </item>

    <item
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp"
        android:left="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#08FFFFFF" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</layer-list>
