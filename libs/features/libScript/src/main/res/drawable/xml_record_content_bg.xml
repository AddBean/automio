<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#15000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    
    <!-- Content background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/tech_content_bg"
                android:centerColor="@color/tech_blue_secondary"
                android:endColor="@color/tech_content_bg"
                android:type="linear" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/tech_content_border" />
        </shape>
    </item>
</layer-list> 