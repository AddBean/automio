<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/layout_top"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@drawable/xml_gradient_bottom_bg"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:padding="18dp"
            android:src="@drawable/x_file_back2"
            android:tint="@color/color_ff383838" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="56dp"
            android:layout_marginRight="80dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lines="1"
                android:singleLine="true"
                android:textColor="@color/color_black"
                android:textSize="18sp"
                tools:text="图片名称" />

            <TextView
                android:id="@+id/tv_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="-"
                android:textColor="@color/color_ff666666"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="30dp"
            android:gravity="center"
            android:text="1/1"
            android:textColor="@color/color_ff666666"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_alignParentBottom="true"
            android:background="@color/white_6" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/layout_bottom"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/xml_gradient_top_bg">

        <com.hive.views.widgets.TextDrawableView
            android:id="@+id/tv_send"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/btn_file_share"
            android:textColor="@color/color_ff383838"
            android:textSize="12sp"
            app:drawableHeight="30dp"
            android:singleLine="true"
            app:drawableTop="@drawable/x_file_preview_share"
            app:drawableWidth="30dp" />

        <com.hive.views.widgets.TextDrawableView
            android:id="@+id/tv_fav"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/btn_file_fav"
            android:textColor="@color/color_ff383838"
            android:textSize="12sp"
            app:drawableHeight="30dp"
            android:singleLine="true"
            app:drawableTop="@drawable/x_file_like"
            app:drawableWidth="30dp" />

        <com.hive.views.widgets.TextDrawableView
            android:id="@+id/tv_delete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/btn_file_delete"
            android:textColor="@color/color_ff383838"
            android:textSize="12sp"
            app:drawableHeight="30dp"
            app:drawableTop="@drawable/x_file_preview_delete"
            app:drawableWidth="30dp" />

        <com.hive.views.widgets.TextDrawableView
            android:id="@+id/tv_rotate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/btn_file_rotate"
            android:textColor="@color/color_ff383838"
            android:textSize="12sp"
            app:drawableHeight="30dp"
            app:drawableTop="@drawable/x_file_rotate2"
            app:drawableWidth="30dp" />

        <com.hive.views.widgets.TextDrawableView
            android:id="@+id/tv_more"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/btn_file_info"
            android:textColor="@color/color_ff383838"
            android:textSize="12sp"
            app:drawableHeight="30dp"
            app:drawableTop="@drawable/x_file_info"
            app:drawableWidth="30dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>