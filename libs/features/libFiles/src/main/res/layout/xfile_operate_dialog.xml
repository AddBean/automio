<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBgTransBlack"
    android:clickable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/xml_ffffff_round_rect_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <com.wang.avi.AVLoadingIndicatorView
            android:id="@+id/iv_anim"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            app:indicatorColor="@color/colorRed"
            app:indicatorName="BallBeatIndicator" />

        <TextView
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/iv_anim"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:ellipsize="middle"
            android:gravity="center"
            android:maxLength="30"
            android:singleLine="true"
            android:text="@string/x_file_operate_running"
            android:textColor="@color/color_blue"
            android:textSize="16dp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/tv_info"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/iv_anim"
            android:layout_centerHorizontal="true"
            android:ellipsize="middle"
            android:gravity="center"
            android:maxLength="30"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/color_gran"
            android:textSize="10sp"
            android:textStyle="normal"
            tools:text="testtesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttest" />
    </LinearLayout>

</RelativeLayout>