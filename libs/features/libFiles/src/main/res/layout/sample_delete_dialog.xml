<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/xml_ffffff_round_rect_bg"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="-"
            android:textColor="@color/text_dark_secondary"
            android:textSize="16dp" />

        <TextView
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="16dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:textColor="@color/text_dark_secondary"
            android:textSize="14dp"
            tools:text="-" />

        <com.hive.views.widgets.TextDrawableView
            android:id="@+id/bin_check_box"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:text="@string/check_is_recycle_to_bin"
            android:textColor="@color/color_gran"
            android:textSize="12sp"
            app:drawableHeight="12dp"
            app:drawableLeft="@drawable/x_file_selector_unselected"
            app:drawableWidth="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/text_white_95" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/cancel"
                android:textColor="@color/text_dark_secondary"
                android:textSize="14dp" />

            <View
                android:id="@+id/view_lines"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/text_white_95" />

            <TextView
                android:id="@+id/tv_btn_submit"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/ok"
                android:textColor="@color/color_00AAEE"
                android:textSize="14dp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>