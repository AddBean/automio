<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/color_white"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        app:cardMaxElevation="10dp"
        app:cardUseCompatPadding="true"
        app:contentPadding="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="@string/x_file_file_layout"
                    android:textColor="@color/color_black"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/switch_layout_list"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="16dp"
                    android:padding="8dp"
                    android:src="@drawable/xml_switch_layout_list" />

                <ImageView
                    android:id="@+id/switch_layout_grid"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="9dp"
                    android:padding="10dp"
                    android:src="@drawable/xml_switch_layout_grid" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="@string/x_file_file_sort"
                    android:textColor="@color/color_black"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/switch_layout_sort_name"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="16dp"
                    android:padding="8dp"
                    android:src="@drawable/xml_switch_sort_name" />

                <ImageView
                    android:id="@+id/switch_layout_sort_size_asc"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="10dp"
                    android:padding="10dp"
                    android:src="@drawable/xml_switch_sort_size_asc" />

                <ImageView
                    android:id="@+id/switch_layout_sort_size_desc"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="10dp"
                    android:padding="10dp"
                    android:src="@drawable/xml_switch_sort_size_desc" />

                <ImageView
                    android:id="@+id/switch_layout_sort_class"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="10dp"
                    android:padding="10dp"
                    android:src="@drawable/xml_switch_sort_class" />

                <ImageView
                    android:id="@+id/switch_layout_sort_time"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="10dp"
                    android:padding="10dp"
                    android:src="@drawable/xml_switch_sort_time" />


            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>